<UserControl x:Class="TogglDesktop.OverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"  
             d:DesignHeight="300" d:DesignWidth="300"
             MinWidth="300"
             MinHeight="428"
             Background="{DynamicResource Toggl.Background}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/DesignUpdate/Hyperlink.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <Image Source="/TogglDesktop;component/Resources/restricted-area.png"
               Margin="5 30 0 0"
               HorizontalAlignment="Center"
               Stretch="None"/>
        <TextBlock Style="{StaticResource Toggl.TitleText}"
                   Margin="0 16 0 0"
                   HorizontalAlignment="Center"
                   Text="{DynamicResource s_no_access}" />

        <StackPanel Name="missingWorkspacePanel" Margin="0 16 0 0">
            <TextBlock Style="{StaticResource Toggl.BodyGrayText}"
                       Margin="32 16 32 0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Text="{DynamicResource s_you_no_longer_have_access_to_your_last_workspace}" />
            <TextBlock Margin="0 24 0 0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center">
                <Hyperlink Style="{StaticResource Toggl.AccentHyperlink}"
                           NavigateUri="https://toggl.com/"
                           RequestNavigate="CreateWorkspaceOnClick"><Run Text="{DynamicResource s_create_a_workspace}"/></Hyperlink>
            </TextBlock>
            <TextBlock Style="{StaticResource Toggl.BodyGrayText}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0 2 0 0"
                       Text="{DynamicResource s_to_continue_tracking_or}" />
            <TextBlock Margin="0 2 0 0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center">
                <Hyperlink Style="{StaticResource Toggl.AccentHyperlink}"
                           Click="ReLoginOnClick"><Run Text="{DynamicResource s_log_in_with_a_different_account}"/></Hyperlink>
            </TextBlock>
            <TextBlock Style="{StaticResource Toggl.CaptionText}"
                       Margin="32 52 32 0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Text="{DynamicResource s_don_t_think_you_should_be_seeing_this}" />
            <TextBlock Margin="0 2 0 0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center">
                <Hyperlink Style="{StaticResource Toggl.NormalHyperlink}"
                           Click="RefreshNowOnClick"><Run Text="{DynamicResource s_refresh_now}"/></Hyperlink>
            </TextBlock>
        </StackPanel>
        <StackPanel Name="tosChangesPanel" Margin="0 16 0 0">
            <TextBlock Style="{StaticResource Toggl.BodyGrayText}"
                       Margin="32 16 32 0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Text="{DynamicResource s_our_terms_of_service_and_privacy_policy_have_cha}" />
            <TextBlock Style="{StaticResource Toggl.BodyGrayText}"
                       Margin="0 24 0 0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center">
                <Run Text="{DynamicResource s_please_read_and_accept_our_updated}" />
                <LineBreak />
                <Hyperlink Style="{StaticResource Toggl.AccentHyperlink}"
                           NavigateUri="https://toggl.com/legal/terms"
                           RequestNavigate="openTos"><Run Text="{DynamicResource s_terms_of_service}"/></Hyperlink>
                <LineBreak />
                <Hyperlink Style="{StaticResource Toggl.AccentHyperlink}"
                           NavigateUri="https://toggl.com/legal/privacy"
                           RequestNavigate="openPrivacy"><Run Text="{DynamicResource s_privacy_policy}"/></Hyperlink>
            </TextBlock>
            <Button Style="{StaticResource Toggl.PrimaryButton}"
                    Margin="0 24 0 0"
                    Width="96"
                    Content="{DynamicResource s_i_accept}"
                    Click="onAcceptTosClick" />
            <TextBlock Style="{StaticResource Toggl.CaptionText}"
                       Margin="0 32 0 0"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Text="{DynamicResource s_if_you_have_any_questions_contact_us_at_support}" />
        </StackPanel>
    </StackPanel>
</UserControl>
