<togglDesktop:TogglNotification x:Class="TogglDesktop.AutotrackerNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:togglDesktop="clr-namespace:TogglDesktop"
             mc:Ignorable="d"
             Title="{DynamicResource s_toggl_track_autotracker}">
    <Button Style="{DynamicResource Toggl.PrimaryButton}"
            Content="{DynamicResource s_yes_start_tracking}"
            Click="onStartButtonClick"/>
</togglDesktop:TogglNotification>
